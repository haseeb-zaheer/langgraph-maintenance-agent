# Local-only environment variables. Do not commit real values.

# Required only for --llm mode.
OPENROUTER_API_KEY=

# Optional. Defaults to deepseek/deepseek-v4-flash.
LANGGRAPH_MAINTENANCE_LLM_MODEL=deepseek/deepseek-v4-flash

# Optional Discord delivery. Disabled by default unless enabled in config or
# forced with --send-discord.
LANGGRAPH_MAINTENANCE_DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Wrapper/systemd runtime settings.
LANGGRAPH_MAINTENANCE_CONFIG=examples/repos.yaml
LANGGRAPH_MAINTENANCE_TIMEOUT_SECONDS=3600
LANGGRAPH_MAINTENANCE_USE_LLM=0
LANGGRAPH_MAINTENANCE_MAX_CONCURRENCY=4
